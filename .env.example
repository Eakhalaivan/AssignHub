# Application Port
PORT=8082

# Database Details
DB_URL=jdbc:mysql://localhost:3306/academix?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Security Tokens
JWT_SECRET=academix-super-secret-key-must-be-256-bits-long-for-hs256-algo
JWT_ACCESS_EXPIRATION=28800000
JWT_REFRESH_EXPIRATION=604800000

# Payment Gateway
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=yourkeysecret

# Platform Commission
COMMISSION_PERCENT=15

# File Storage
UPLOAD_DIR=uploads

# Mail Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173
